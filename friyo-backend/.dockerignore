# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (builder stage creates its own)
dist/

# Environment files — NEVER bake into image
.env
.env.*
!.env.example

# Development / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Git
.git/
.gitignore
.github/

# Test files
coverage/
test/
**/*.spec.ts
**/*.e2e-spec.ts
jest.config.ts

# Docs & infra scripts (not needed at runtime)
*.md
infra/
docs/

# Docker
Dockerfile
docker-compose*.yml
.dockerignore
